# NOVA Ultimate configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
ELEVENLABS_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
PORT=3000
NODE_ENV=development
NOVA_PERSONALITY=jarvis
# Optional NOVA creator / read-only authorization layer
NOVA_CREATOR_TOKEN=
NOVA_CREATOR_EMAIL=
NOVA_VIEWER_TOKEN=
NOVA_DATA_DIR=./data/nova-store
# NOVA Voice Engine — provider credentials stay server-side
ELEVENLABS_MODEL=eleven_flash_v2_5
NOVA_DEFAULT_VOICE=nova
NOVA_VOICE_ID=
JARVIS_VOICE_ID=
FRIDAY_VOICE_ID=
ATLAS_VOICE_ID=
LYRA_VOICE_ID=
ORION_VOICE_ID=
NOVA_VOICE_STABILITY=0.5
NOVA_VOICE_SIMILARITY=0.75
NOVA_VOICE_STYLE=0.15

# NOVA Global AI Router (free-first; paid mode stays off by default)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=openrouter/free
NOVA_APP_URL=https://nova-ultimate-8scp.onrender.com
NOVA_PROVIDER_ORDER=groq,cerebras,gemini,openrouter
NOVA_PAID_MODE=false
NOVA_MAX_OUTPUT_TOKENS=4096
# NOVA task-aware routing. Optional explicit task: vision,coding,reasoning,research,creative,general
# Leave blank for automatic classification.
NOVA_TASK_ROUTING=true

# Global provider/model discovery
HF_TOKEN=
NOVA_DISCOVERY_ENABLED=true
NOVA_DISCOVERY_TTL_MS=900000
NOVA_DYNAMIC_MODEL_SELECTION=true

# Universal discovery policy
# Free mode only routes to models classified free/free-tier by NOVA's catalog.
# Paid providers/models are ignored until NOVA_PAID_MODE=true.
NOVA_FREE_ONLY_STRICT=true

# NOVA 21.2 Universal Assistant
NOVA_PROACTIVE=false
NOVA_SAFETY_CONFIRM=true
NOVA_OFFLINE_QUEUE=true
NOVA_CROSS_DEVICE_PROFILE=true

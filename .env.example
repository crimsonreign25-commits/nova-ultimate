# Copy values into your deployment environment; never commit real secrets.
NODE_ENV=production
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key in a password manager/secret manager and back it up securely.
NOVA_DATA_ENCRYPTION_KEY=
# Optional: comma-separated full origins allowed to call NOVA cross-origin.
NOVA_ALLOWED_ORIGINS=
# Set your public HTTPS app URL.
NOVA_APP_URL=https://your-nova-domain.example
# Set false to block cloud AI providers (local AI integration required for responses).
NOVA_EXTERNAL_AI_ENABLED=true
# Supabase environment values are configured separately.
SUPABASE_URL=
SUPABASE_ANON_KEY=
